# Copy this file to .env and fill in your values. .env is gitignored.
# Values are built into the app, so never put secrets here.

# Base URL of the API server, without a path.
#   ws://192.168.1.42:3000  a server on another computer on the same Wi-Fi
#   ws://10.0.2.2:3000      a server on this computer (Android emulator only)
EXPO_PUBLIC_SERVER_URL=ws://xxx.xxxx.xxxx.xxxxxx
